{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Loki": {
      "Url": "http://loki:3100"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "INJECTED_FROM_ENV"
  },
  "Kafka": {
    "BootstrapServers": "kafka:29092",
    "ConsumerGroupId": "organization-service"
  },
  "Jwt": {
    "Key": "INJECTED_FROM_ENV",
    "Issuer": "sallevate",
    "Audience": "sallevate"
  },
  "Frontend": {
    "Url": "http://localhost:3000"
  },
  "MailerSend": {
    "ApiToken": "INJECTED_FROM_ENV",
    "BaseUrl": "https://api.mailersend.com",
    "FromEmail": "INJECTED_FROM_ENV",
    "FromName": "Sellevate"
  },
  "DemoRequests": {
    "NotificationEmail": "INJECTED_FROM_ENV",
    "NotificationRecipientName": "Sellevate",
    "SubmissionCooldownSeconds": 300
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
