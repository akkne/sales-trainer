{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Loki": {
      "Url": "http://loki:3100"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "INJECTED_FROM_ENV",
    "Mongo": "mongodb://mongo:27017",
    "Redis": "redis:6379"
  },
  "Mongo": {
    "DatabaseName": "sallevate"
  },
  "Kafka": {
    "BootstrapServers": "kafka:29092",
    "ConsumerGroupId": "ai-service"
  },
  "Jwt": {
    "Key": "INJECTED_FROM_ENV",
    "Issuer": "sallevate",
    "Audience": "sallevate"
  },
  "Frontend": {
    "Url": "http://localhost:3000"
  },
  "LearningService": {
    "BaseUrl": "http://learning:8080",
    "PracticeContextPath": "/internal/assignments/practice-context",
    "TimeoutSeconds": 5
  },
  "OpenAI": {
    "ApiKey": "INJECTED_FROM_ENV",
    "BaseUrl": "https://api.openai.com",
    "ChatCompletionsPath": "/v1/chat/completions"
  },
  "Whisper": {
    "Model": "whisper-1",
    "ApiUrl": "https://api.openai.com/v1/audio/transcriptions",
    "Language": "ru",
    "MaximumFileSizeMegabytes": 25
  },
  "YandexTts": {
    "ApiKey": "INJECTED_FROM_ENV",
    "BaseUrl": "https://tts.api.cloud.yandex.net",
    "Voice": "marina",
    "Lang": "ru-RU",
    "Speed": "1.2"
  },
  "AiQuotas": {
    "DefaultVoiceDailyLimitMinutes": 600,
    "DefaultVoiceMonthlyLimitMinutes": 6000,
    "DefaultLlmMonthlyTokenLimit": 20000000,
    "DefaultBatchReservePercent": 10,
    "SoftWarningPercent": 80,
    "Currency": "RUB",
    "FallbackPricePerMillionTokens": 0,
    "EstimatedCharactersPerToken": 4,
    "PricePerMillionTokens": {
      "yandex-tts": 1300
    }
  },
  "Voice": {
    "Enabled": true,
    "TtsProvider": "yandex",
    "VadSilenceMs": 1200,
    "MaxRecordingSeconds": 60,
    "DailyLimitMinutes": 30,
    "MonthlyLimitMinutes": 300
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
