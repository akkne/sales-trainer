{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Loki": {
      "Url": "http://loki:3100"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "INJECTED_FROM_ENV",
    "Redis": "redis:6379"
  },
  "Kafka": {
    "BootstrapServers": "kafka:29092",
    "ConsumerGroupId": "learning-service"
  },
  "Jwt": {
    "Key": "INJECTED_FROM_ENV",
    "Issuer": "sallevate",
    "Audience": "sallevate"
  },
  "AiService": {
    "BaseUrl": "http://ai:8080",
    "EvaluatePath": "/ai/evaluate",
    "ChatPath": "/ai/chat",
    "ChatStreamPath": "/ai/chat/stream",
    "TextToSpeechPath": "/ai/tts",
    "ChatTimeoutSeconds": 90
  },
  "IdentityService": {
    "BaseUrl": "http://identity:8080",
    "ActiveMemberIdsPath": "/internal/memberships/active",
    "TimeoutSeconds": 10
  },
  "Assignments": {
    "DeadlineNoticeLeadHours": 24,
    "SweepIntervalMinutes": 30
  },
  "Frontend": {
    "Url": "http://localhost:3000"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
